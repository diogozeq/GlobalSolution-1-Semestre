# ===== OrbitGuard AI - backend environment =====
# Copy to .env and fill what you have. The app runs offline with fixtures
# even if every key below is empty.

# --- App ---
ENVIRONMENT=development
DATABASE_URL=sqlite:///./orbitguard.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- NASA FIRMS (fire foci). Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key ---
FIRMS_MAP_KEY=

# --- OpenRouter (AI reports + RAG agent). Key: https://openrouter.ai/keys ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model fallback lists (first available wins). IDs are configurable.
LLM_REPORT_MODELS=anthropic/claude-3.5-sonnet,openai/gpt-4o-mini,meta-llama/llama-3.1-8b-instruct
LLM_AGENT_MODELS=openai/gpt-4o-mini,meta-llama/llama-3.1-8b-instruct

# --- RAG ---
# local = use ChromaDB semantic embeddings if installed, else TF-IDF fallback
# none  = force TF-IDF fallback
EMBEDDINGS_PROVIDER=local
CHROMA_PATH=./.chroma

# --- HTTP ---
HTTP_TIMEOUT=20
HTTP_RETRIES=2

# --- Risk engine weights (sum should be 1.0) ---
RISK_W_FIRE=0.40
RISK_W_WEATHER=0.30
RISK_W_SPREAD=0.15
RISK_W_TREND=0.15
