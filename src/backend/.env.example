# ===== OrbitGuard AI - backend environment =====
# Copy to .env and fill what you have. Default runtime uses real public APIs.
# Fixtures are available only when /ingest/run is called with use_fixture=true.

# --- App ---
ENVIRONMENT=development
DATABASE_URL=sqlite:///./orbitguard.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- NASA FIRMS (fire foci). Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key ---
# If empty, INPE still provides real Brazil fire foci without key.
FIRMS_MAP_KEY=

# --- OpenRouter (AI reports + RAG agent). Key: https://openrouter.ai/keys ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Primary model pools rotate per request. If the chosen model fails, the router
# tries the remaining pool, then the stable fallback list.
# Reports use JSON mode, so JSON-capable models are first.
LLM_REPORT_MODELS=minimax/minimax-m3,deepseek/deepseek-v4-flash,xiaomi/mimo-v2.5,openrouter/owl-alpha,tencent/hy3-preview
LLM_AGENT_MODELS=deepseek/deepseek-v4-flash,minimax/minimax-m3,tencent/hy3-preview,xiaomi/mimo-v2.5,openrouter/owl-alpha
LLM_FALLBACK_MODELS=~openai/gpt-latest,~anthropic/claude-sonnet-latest,meta-llama/llama-3.1-8b-instruct

# --- RAG ---
# local = use ChromaDB semantic embeddings if installed, else TF-IDF fallback
# none  = force TF-IDF fallback
EMBEDDINGS_PROVIDER=local
CHROMA_PATH=./.chroma

# --- HTTP ---
HTTP_TIMEOUT=20
HTTP_RETRIES=2

# --- Risk engine weights (sum should be 1.0) ---
RISK_W_FIRE=0.40
RISK_W_WEATHER=0.30
RISK_W_SPREAD=0.15
RISK_W_TREND=0.15
